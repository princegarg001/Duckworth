# Copy to .env for local development:  cp .env.example .env
# Every variable is validated at boot; the process exits if this file is wrong.

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://ipl:ipl@localhost:5432/ipl
DATABASE_POOL_MAX=10
# Hard ceiling on any single query. An unbounded query is how a healthy
# service becomes an unhealthy one under load.
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_SSL=false

# ── Cache & rate limiting (optional) ─────────────────────────────────────
# Omit REDIS_URL entirely to run without a cache; the API degrades to
# uncached reads and an in-memory rate limiter rather than failing to start.
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ── API server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
# Explicit allowlist, comma-separated. Never "*" — rejected in production.
CORS_ORIGINS=http://localhost:3001
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
# Must exceed the load balancer's drain window. See docs/runbook.md.
SHUTDOWN_TIMEOUT_MS=10000
# Guards POST /internal/*. Required in production; generate with:
#   openssl rand -hex 32
INTERNAL_API_TOKEN=dev-token-change-me-0123456789abcdef
TRUST_PROXY=false

# ── Observability ────────────────────────────────────────────────────────
LOG_LEVEL=info
SERVICE_NAME=ipl-api
SERVICE_VERSION=1.0.0
GIT_SHA=local
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true

# ── Ingest ───────────────────────────────────────────────────────────────
SOURCE_DIR=./data/raw
BATCH_SIZE=5000

# ── Web ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
