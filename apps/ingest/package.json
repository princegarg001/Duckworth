{
  "name": "@ipl/ingest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "ingest": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
