{
  "name": "ipl-platform",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @ipl/db generate",
    "db:migrate": "pnpm --filter @ipl/db migrate",
    "ingest": "pnpm --filter @ipl/ingest start",
    "contracts:openapi": "pnpm --filter @ipl/api openapi:emit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ],
    "overrides": {
      "handlebars": ">=4.7.9",
      "postcss": ">=8.5.23",
      "vite": ">=6.4.3",
      "undici": ">=6.28.0",
      "uuid": ">=11.1.1",
      "esbuild": ">=0.25.0",
      "@fastify/static": ">=10.1.2",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "@opentelemetry/core": ">=2.8.0",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "protobufjs": ">=8.4.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
